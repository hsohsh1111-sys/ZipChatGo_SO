DB_HOST=
DB_PORT=4000
DB_USERNAME=''
DB_PASSWORD=''
DB_DATABASE='sys'

# 지도 탐색용 MOLIT API
MOLIT_MAP_SERVICE_KEY=

# 부동산 분석용 MOLIT API
MOLIT_SERVICE_KEY=
DEFAULT_LAWD_CD=41117
NAVER_MAPS_CLIENT_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Spring -> FastAPI. AI_SERVER_BASE_URL remains supported as a legacy fallback.
AI_SERVER_URL=http://localhost:8000
AI_SERVER_BASE_URL=http://localhost:8000
# FastAPI -> Spring
SPRING_SERVER_BASE_URL=http://localhost:8080
# Optional locally. In Render, set the same secret on both services.
INTERNAL_API_KEY=
ENABLE_API_DOCS=true
AI_SEARCH_DIAGNOSTICS=false
OPENAI_API_KEY=
# FastAPI 운영 챗봇에서만 사용하는 모델입니다.
OPENAI_MODEL=gpt-4o-mini
# 운영 챗봇과 분리된 공인중개사 시험 평가 전용 모델입니다.
OPENAI_EXAM_EVALUATION_MODEL=gpt-4o-mini
LAW_API_OC=
LAW_VECTOR_STORE_ID=
